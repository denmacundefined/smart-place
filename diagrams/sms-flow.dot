digraph sms {
  graph [label="SMS command | Sequence",labelloc=t,fontname="DejaVu Sans",fontsize=18,rankdir=TB,pad=0.2,nodesep=0.2,ranksep=0.36,bgcolor="transparent"];
  node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=11,color="#B7CCDC",fillcolor="#F5F9FC",margin="0.25,0.12"];
  edge [color="#6689A1",penwidth=1.25,arrowsize=0.65];
  s1 [label="1  User sends: get guard"];
  s2 [label="2  LTE receives SMS in /tool sms inbox"];
  s3 [label="3  SMS Scheduler starts smart-place-sms-handler"];
  s4 [label="4  Validate sender, whitelist and command"];
  s5 [label="5  Read flash/smart-place-device-guard.json"];
  s6 [label="6  GET http://192.168.12.254/  → RAM file"];
  s7 [label="7  Parse JSON and format key = value lines"];
  s8 [label="8  Send numbered SMS pages (3 s between pages)"];
  s9 [label="9  Mark handled in RAM, attempt Inbox deletion"];
  s1->s2->s3->s4->s5->s6->s7->s8->s9;
}
